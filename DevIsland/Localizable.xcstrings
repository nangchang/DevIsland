          "stringUnit": {
            "state": "translated",
            "value": "안전한 tmux 방식은 AoE에 /session 텍스트를 보내지 않습니다. 대시보드 행 이동이 필요할 때만 검색 방식을 사용하세요."
          }
        }
      }
    },
    "hintCaffeineRule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, sleep is prevented while on AC power; always off on excluded Wi-Fi or when battery is ≤ 20%."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켰을 때만 동작합니다. 전원 연결 시 슬립이 차단되며, 예외 Wi-Fi 또는 배터리 20% 이하에서는 항상 비활성화됩니다."
          }
        }
      }
    },
    "hintCaffeineSessionTimeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeine turns off automatically after all sessions have been idle or terminated for the configured duration."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 시간 동안 모든 세션이 유휴 또는 종료 상태이면 Caffeine이 자동으로 꺼집니다."
          }
        }
      }
    },
    "hintExpandOnApprovalRequest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a tool approval request is received."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 사용 승인 요청이 수신될 때"
          }
        }
      }
    },
    "hintExpandOnIdlePrompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the agent is done and waiting for the next prompt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 완료 후 다음 프롬프트를 기다릴 때"
          }
        }
      }
    },
    "hintExpandOnInteractiveTool": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini only — when an interactive tool (e.g. bash) is waiting for terminal input."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini 전용 — 터미널 입력을 기다리는 인터랙티브 툴이 실행될 때"
          }
        }
      }
    },
    "hintExpandOnNotification": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand when a notification event occurs. Use the sub-options to choose which kinds."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 이벤트 발생 시 펼칩니다. 하위 항목으로 종류를 선택하세요."
          }
        }
      }
    },
    "hintExpandOnNotificationMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a notification includes a question or message from the agent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 질문이나 메시지를 알림으로 보낼 때"
          }
        }
      }
    },
    "hintExpandOnQuestionResponse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the agent sends a question and waits for a response."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 사용자에게 질문을 보내고 응답을 기다릴 때"
          }
        }
      }
    },
    "hintExpandOnTaskCompletion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an agent finishes its task."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 작업을 완료했을 때"
          }
        }
      }
    },
    "hintGraceModeResolve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-install the bridge to generate a token file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지를 재설치하면 토큰 파일이 생성됩니다."
          }
        }
      }
    },
    "hintPreferredTerminal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when opening a session in a new terminal window. Falls back to the session's original terminal app if not set."
