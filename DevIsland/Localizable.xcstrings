    },
    "descSessionRules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session rules remain available until the corresponding active session is removed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 규칙은 해당 활성 세션이 제거될 때까지 유지됩니다."
          }
        }
      }
    },
    "descTransport": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport changes are written to the bridge runtime config. Restart DevIsland after switching listener transports."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 변경 사항은 브리지 런타임 설정에 기록됩니다. 리스너 전송 방식 변경 후 DevIsland를 재시작하세요."
          }
        }
      }
    },
