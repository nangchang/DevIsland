{
  "sourceLanguage": "en",
  "strings": {
    "addAllRisk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add all %@ tools"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 도구 모두 추가"
          }
        }
      }
    },
    "alertAddGlobalToolMsg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the tool name (e.g. read_file) to auto-approve in all sessions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세션에서 자동 승인할 툴 이름(예: read_file)을 입력하세요."
          }
        }
      }
    },
    "alertAddGlobalToolTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Global Auto-Approval Tool"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글로벌 자동 승인 툴 추가"
          }
        }
      }
    },
    "alertAddSessionToolMsg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the tool name to auto-approve in session %@."
