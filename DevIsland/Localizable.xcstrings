    "descCodex": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex session approval will use DevIsland-managed cache and persistent SQLite rules in later phases."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 세션 승인은 이후 단계에서 DevIsland 관리 캐시와 영구 SQLite 규칙을 사용합니다."
          }
        }
      }
    },
    "descGemini": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompts for approval on risky tools even when running with --auto-approve or --yolo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--auto-approve 또는 --yolo로 실행 중일 때도 위험한 도구는 승인을 요청합니다."
          }
        }
      }
    },
    "descGlobalRules": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These existing DevIsland rules are checked for every session before showing an approval prompt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 DevIsland 규칙은 승인 프롬프트 표시 전 모든 세션에서 확인됩니다."
          }
        }
      }
    },
    "descNotificationsEnabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a macOS notification when a tool needs approval. Includes Approve and Deny buttons when app is in background."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 승인이 필요할 때 macOS 알림을 보냅니다. 앱이 백그라운드에 있을 때 허용/거부 버튼이 표시됩니다."
          }
        }
      }
    },
    "descPTYHooks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script forwards PTYOutput hook events to the app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트가 PTYOutput 훅 이벤트를 앱으로 전달합니다."
          }
        }
      }
    },
    "descPTYUsage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a CLI agent through the PTY wrapper:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 에이전트를 PTY 래퍼를 통해 실행:"
          }
        }
      }
    },
    "descProcessClaudeDesktop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process hook events from sessions running in Claude Desktop."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 데스크탑에서 실행 중인 세션의 hook 이벤트를 처리합니다."
          }
        }
      }
    },
    "descProcessCodexDesktop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Process hook events from sessions running in Codex Desktop."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 데스크탑에서 실행 중인 세션의 hook 이벤트를 처리합니다."
          }
        }
      }
    },
    "descProcessVSCode": {
      "localizations": {
