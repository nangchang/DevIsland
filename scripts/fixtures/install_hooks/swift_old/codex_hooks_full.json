{
  "hooks" : {
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "\"\/BRIDGE\" --source codex",
            "timeout" : 86400,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\"\/BRIDGE\" --source codex",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\/usr\/local\/bin\/other-hook.sh",
            "type" : "command"
          }
        ],
        "matcher" : "other"
      },
      {
        "hooks" : [
          {
            "command" : "\"\/BRIDGE\" --source codex",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "\/usr\/local\/bin\/other-hook.sh",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\/usr\/local\/bin\/other-hook.sh",
            "type" : "command"
          },
          {
            "command" : "\"\/BRIDGE\" --source codex",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "\"\/BRIDGE\" --source codex",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ]
  }
}