{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/other-hook.sh"
          },
          {
            "type": "command",
            "command": "\"/BRIDGE\" --source codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/other-hook.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/BRIDGE\" --source codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/other-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/BRIDGE\" --source codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/BRIDGE\" --source codex"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/BRIDGE\" --source codex",
            "timeout": 86400
          }
        ]
      }
    ]
  }
}